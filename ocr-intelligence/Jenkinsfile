// OCR Intelligence - CI pipeline (Assignment 5).
// Requires a Linux agent with: git, python3 (>= 3.10) + venv, docker. No GPU and no OCR weights needed:
// unit tests use a stub OCR engine; the real-model test is marked "integration" and is NOT run here.
//
// If the Jenkins job points at a repository where this project lives in an "ocr-intelligence/" folder,
// set the job's Script Path to "ocr-intelligence/Jenkinsfile" - the APP_DIR logic below handles both layouts.

pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    triggers {
        // Fires on GitHub webhook (Payload URL: https://<jenkins>/github-webhook/, event: push).
        githubPush()
        // Fallback when the webhook cannot reach Jenkins (e.g. local Jenkins): poll every ~5 minutes.
        pollSCM('H/5 * * * *')
    }

    environment {
        DJANGO_SECRET_KEY = 'ci-only-not-a-secret'
        CELERY_TASK_ALWAYS_EAGER = '1'
        PIP_DISABLE_PIP_VERSION_CHECK = '1'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.APP_DIR = fileExists('ocr-intelligence/backend') ? 'ocr-intelligence' : '.'
                }
                echo "Application directory: ${env.APP_DIR}"
            }
        }

        stage('Install test dependencies') {
            steps {
                dir("${env.APP_DIR}/backend") {
                    // Uses the system python3 when it can create a venv; otherwise downloads a private
                    // Python 3.12 via uv (no root needed), so a bare Jenkins image still works.
                    sh '''
                        if command -v python3 >/dev/null 2>&1 && python3 -c "import venv, ensurepip" >/dev/null 2>&1; then
                            python3 -m venv .venv
                        else
                            echo "python3 with venv not found - bootstrapping Python 3.12 with uv"
                            export UV_INSTALL_DIR="$HOME/.local/bin" UV_NO_MODIFY_PATH=1
                            curl -LsSf https://astral.sh/uv/install.sh | sh
                            "$UV_INSTALL_DIR/uv" venv --python 3.12 --seed .venv
                        fi
                        . .venv/bin/activate
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Django checks') {
            steps {
                dir("${env.APP_DIR}/backend") {
                    sh '''
                        . .venv/bin/activate
                        export DJANGO_SETTINGS_MODULE=config.test_settings
                        python manage.py check
                        python manage.py makemigrations --check --dry-run
                    '''
                }
            }
        }

        stage('Unit tests') {
            steps {
                dir("${env.APP_DIR}/backend") {
                    // File validation, API, status transitions, DOCX generation, downloads, error handling
                    sh '''
                        . .venv/bin/activate
                        python -m pytest --junitxml=test-results.xml
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${env.APP_DIR}/backend/test-results.xml"
                }
            }
        }

        // Runs only when every previous stage succeeded.
        stage('Docker build') {
            steps {
                script {
                    def dockerReady = sh(returnStatus: true, script: 'docker info >/dev/null 2>&1') == 0
                    if (!dockerReady) {
                        // Tests passed, but this Jenkins cannot reach Docker (see jenkins/Dockerfile and README).
                        unstable('Docker is not available on this Jenkins - image build skipped')
                    } else {
                        dir("${env.APP_DIR}") {
                            sh '''
                                docker build -t ocr-intelligence-backend:${IMAGE_TAG} backend
                                docker build --target prod -t ocr-intelligence-frontend:${IMAGE_TAG} frontend
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success  { echo 'Pipeline status: SUCCESS' }
        unstable { echo 'Pipeline status: UNSTABLE (tests passed, Docker image build skipped)' }
        failure { echo 'Pipeline status: FAILURE' }
        always  { cleanWs(deleteDirs: true, patterns: [[pattern: '**/.venv/**', type: 'INCLUDE']]) }
    }
}
