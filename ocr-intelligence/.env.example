# Copy to .env and edit. Never commit .env.

# --- Django ---
DJANGO_DEBUG=1
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=ocr_engine_django_s3cr3t_k3y_0pt10n
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# --- PostgreSQL (Compose sets POSTGRES_HOST=postgres; leave POSTGRES_HOST unset locally to use SQLite) ---
POSTGRES_DB=ocr_intelligence
POSTGRES_USER=ocr
POSTGRES_PASSWORD=ocr_engine_pg_p4ssw0rd
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Celery / Redis (Compose overrides these with the redis service) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=1

# --- Upload limits ---
OCR_MAX_FILE_SIZE_MB=20
OCR_MAX_FILES_PER_JOB=2
OCR_MAX_PAGES_PER_DOCUMENT=30
OCR_PDF_RENDER_DPI=200

# --- OCR models (PaddleOCR 3.x) ---
OCR_ENGINE_BACKEND=paddle
OCR_MULTILINGUAL_REC_MODEL=cyrillic_PP-OCRv5_mobile_rec
OCR_ENGLISH_REC_MODEL=en_PP-OCRv5_mobile_rec
OCR_DETECTION_MODEL=PP-OCRv5_mobile_det
OCR_CPU_THREADS=4
# Weight cache; Compose mounts a named volume here so weights survive container restarts
# PADDLE_PDX_CACHE_HOME=/models
